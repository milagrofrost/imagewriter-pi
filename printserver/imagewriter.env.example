# /etc/imagewriter/imagewriter.env
# Readable only by root and the lp group. Never commit a real key.

# Required by ImageWriter-AI and ImageWriter-Banner. Create one at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Most pages any printer will print for one job
IMAGEWRITER_MAX_PAGES=4

# Longest PDF that ImageWriter-AI will send to Claude
IMAGEWRITER_MAX_INPUT_PAGES=50

# Longest banner ImageWriter-Banner will design or print, in feet
IMAGEWRITER_MAX_BANNER_FEET=10

# Seconds ImageWriter-Graphics and ImageWriter-Banner wait for a busy or offline printer before dropping the job
IMAGEWRITER_BUSY_TIMEOUT=600

# Claude settings for ImageWriter-AI and ImageWriter-Banner
IMAGEWRITER_MODEL=claude-opus-5-5
IMAGEWRITER_EFFORT=medium
